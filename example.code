let global_val = 10;

scope math {
    scope constants {
        let factor = 2;
        let offset = 5;
    }
}

scope calculation {
    import global_val;
    import math.constants;
    import constants.factor;

    let intermediate = global_val * factor;

    {
        import constants.offset;
        let total = intermediate + offset;
    }
}
