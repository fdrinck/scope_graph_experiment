let global_val = 10;

scope math {
    scope constants {
        let factor = 2;
        let offset = 5;
    }
}

scope calculation {
    import global_val;
    import math.constants;

    let intermediate = global_val * constants.factor;

    {
        let intermediate = intermediate + 1;
        let total = intermediate + constants.offset;
    }
}
